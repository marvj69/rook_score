rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidVoiceImprovementSample() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion',
          'prompt',
          'context',
          'target',
          'outcome',
          'model',
          'revision',
          'appVersion',
          'createdAt'
        ])
        && data.schemaVersion == 2
        && data.prompt is string
        && data.prompt.size() > 0
        && data.prompt.size() <= 1000
        && data.context is map
        && data.context.keys().hasOnly([
          'teams',
          'knownPlayers',
          'totals',
          'roundNumber',
          'gameOver',
          'winner',
          'biddingTeam',
          'hasActiveBid',
          'bidAmount',
          'enterBidderPoints',
          'dealers',
          'currentDealer',
          'misdealCount',
          'undoneRoundsCount',
          'recentRounds',
          'bidPresets',
          'library',
          'statistics',
          'ui',
          'settings'
        ])
        && data.context.teams is map
        && data.context.knownPlayers is list
        && data.context.knownPlayers.size() <= 100
        && data.context.totals is map
        && data.context.roundNumber is number
        && data.context.gameOver is bool
        && data.context.dealers is list
        && data.context.dealers.size() <= 4
        && data.context.recentRounds is list
        && data.context.recentRounds.size() <= 5
        && data.context.library is map
        && data.context.statistics is map
        && data.context.ui is map
        && data.context.settings is map
        && data.target is map
        && data.target.keys().hasOnly(['status', 'requiresConfirmation', 'actions'])
        && data.target.status in ['execute', 'confirm', 'clarify', 'unsupported']
        && data.target.requiresConfirmation is bool
        && data.target.actions is list
        && data.target.actions.size() <= 5
        && data.outcome in ['success', 'failed', 'cancelled', 'clarify', 'unsupported']
        && data.model is string
        && data.model.size() <= 120
        && data.revision is string
        && data.revision.size() <= 80
        && data.appVersion is string
        && data.appVersion.size() <= 40
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }

    match /rookData/{userId} {
      allow read, write: if isSignedInOwner(userId);
    }

    match /voiceImprovement/{userId}/samples/{sampleId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && isValidVoiceImprovementSample();
      allow read, update, delete: if false;
    }
  }
}
