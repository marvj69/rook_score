{
  "name": "rook-score",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:ios && npm run build:sw",
    "build:js": "node scripts/build-js-bundle.mjs",
    "build:css": "npm run build:css:utilities && npm run build:css:app && node scripts/build-startup-css.mjs",
    "build:css:utilities": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c ./tailwind.config.cjs -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "build:css:app": "node scripts/build-app-css.mjs",
    "build:ios": "node scripts/build-ios-launch-screens.mjs",
    "build:sw": "node scripts/stamp-service-worker.mjs",
    "test": "node --test tests/app.test.js tests/runtime-performance.test.js tests/training-data.test.mjs tests/timer.test.js",
    "training:normalize:live": "node scripts/export-live-rook-training-data.mjs",
    "training:candidate": "python3 'Logistic Regression Model/run_normalized_candidate.py'",
    "training:replay": "python3 'Logistic Regression Model/run_engine_replay.py'",
    "training:run": "npm run training:normalize:live && npm run training:candidate && npm run training:replay && npm run training:test",
    "training:test": "node --test tests/training-data.test.mjs && python3 tests/training_model_test.py"
  },
  "devDependencies": {
    "postcss": "8.5.14",
    "tailwindcss": "3.4.17",
    "terser": "5.51.2"
  }
}
